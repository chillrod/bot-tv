  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a6fa3", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#a77bff" } },
    { "scope": ["keyword.operator", "punctuation.separator.key-value"], "settings": { "foreground": "#c9a6ff" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "#7cf5c8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#ffb86b" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#4ff0ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#8fb8ff" } },
    { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#ece7ff" } },
    { "scope": ["variable.other.property", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#cfc8ee" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#ffd29b" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#a77bff" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#4ff0ff", "fontStyle": "italic" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#a77bff", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#4ff0ff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff5c7a" } }
  ]
}

{
  "name": "bot-tv",
  "displayName": "bot_tv",
  "description": "Watch Claude Code work: every read, search, command and edit, live in your editor.",
  "publisher": "chillrod",
  "version": "0.2.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/chillrod/bot-tv" },
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [{ "command": "botTv.toggle", "title": "bot_tv: Pause/Resume" }],
    "viewsContainers": {
      "activitybar": [{ "id": "botTv", "title": "bot_tv", "icon": "media/bot.svg" }]
    },
    "views": {
      "botTv": [{ "type": "webview", "id": "botTv.feed", "name": "bot_tv" }]
    },
    "themes": [{ "label": "bot_tv Vaporwave", "uiTheme": "vs-dark", "path": "./themes/bot-tv-vaporwave-color-theme.json" }],
    "configuration": {
      "title": "bot_tv",
      "properties": {
        "botTv.skin": { "type": "string", "enum": ["vaporwave", "vscode"], "default": "vaporwave", "enumDescriptions": ["Black, neon and glow, with the mascot.", "Follows your VS Code theme."], "description": "Look of the bot_tv panel and of the lines it highlights in the editor." },
        "botTv.port": { "type": "number", "default": 7337, "description": "Local port the Claude Code plugin sends events to." },
        "botTv.stepMs": { "type": "number", "default": 700, "description": "Minimum time (ms) each visual step stays on screen before the next one." }
      }
    }
  }
}
